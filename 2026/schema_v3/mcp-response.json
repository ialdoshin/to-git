{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "mcp-response-v3",
  "title": "Конверт MCP-ответа, security-режим",
  "description": "Финальное JSON-RPC-сообщение на server/discover или tools/call: ровно одно из result или error. У каждого объявленного поля есть явные границы. Неизвестные ключи внутри result, error и _meta проходят, но их число и длина имени ограничены. Кадр SSE схема не описывает: проверяется JSON из события data с полем id.",
  "type": "object",
  "maxProperties": 4,
  "additionalProperties": false,
  "required": ["jsonrpc", "id"],
  "properties": {
    "jsonrpc": { "const": "2.0" },
    "id": { "$ref": "#/definitions/responseId" },
    "result": { "$ref": "#/definitions/result" },
    "error": { "$ref": "#/definitions/error" }
  },
  "oneOf": [
    { "type": "object", "required": ["result"], "properties": { "result": { "$ref": "#/definitions/result" } } },
    { "type": "object", "required": ["error"], "properties": { "error": { "$ref": "#/definitions/error" } } }
  ],
  "definitions": {
    "responseId": {
      "anyOf": [
        { "type": "string", "minLength": 1, "maxLength": 128 },
        { "type": "integer", "minimum": -9007199254740991, "maximum": 9007199254740991 },
        { "type": "null" }
      ]
    },
    "keyName": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256
    },
    "shortText": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256
    },
    "protocolVersion": {
      "type": "string",
      "minLength": 10,
      "maxLength": 10,
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"
    },
    "meta": {
      "type": "object",
      "maxProperties": 32,
      "propertyNames": { "$ref": "#/definitions/keyName" },
      "properties": {
        "io.modelcontextprotocol/serverInfo": {
          "type": "object",
          "maxProperties": 16,
          "propertyNames": { "$ref": "#/definitions/keyName" },
          "required": ["name", "version"],
          "properties": {
            "name": { "$ref": "#/definitions/shortText" },
            "version": { "type": "string", "minLength": 1, "maxLength": 64 }
          }
        }
      }
    },
    "contentItem": {
      "type": "object",
      "maxProperties": 16,
      "propertyNames": { "$ref": "#/definitions/keyName" },
      "required": ["type"],
      "properties": {
        "type": { "type": "string", "minLength": 1, "maxLength": 64 },
        "text": { "type": "string", "minLength": 0, "maxLength": 1048576 },
        "mimeType": { "type": "string", "minLength": 1, "maxLength": 256 },
        "uri": { "type": "string", "minLength": 1, "maxLength": 2048 }
      }
    },
    "result": {
      "type": "object",
      "maxProperties": 32,
      "propertyNames": { "$ref": "#/definitions/keyName" },
      "required": ["resultType"],
      "properties": {
        "resultType": { "const": "complete" },
        "content": {
          "type": "array",
          "minItems": 0,
          "maxItems": 256,
          "items": { "$ref": "#/definitions/contentItem" }
        },
        "isError": { "type": "boolean" },
        "structuredContent": {
          "type": "object",
          "maxProperties": 256,
          "propertyNames": { "$ref": "#/definitions/keyName" }
        },
        "supportedVersions": {
          "type": "array",
          "minItems": 1,
          "maxItems": 32,
          "items": { "$ref": "#/definitions/protocolVersion" }
        },
        "capabilities": {
          "type": "object",
          "maxProperties": 32,
          "propertyNames": { "$ref": "#/definitions/keyName" }
        },
        "ttlMs": { "type": "integer", "minimum": 0, "maximum": 604800000 },
        "cacheScope": { "enum": ["public", "private"] },
        "_meta": { "$ref": "#/definitions/meta" }
      }
    },
    "error": {
      "type": "object",
      "maxProperties": 8,
      "propertyNames": { "$ref": "#/definitions/keyName" },
      "required": ["code", "message"],
      "properties": {
        "code": { "type": "integer", "minimum": -2147483648, "maximum": 2147483647 },
        "message": { "type": "string", "minLength": 0, "maxLength": 8192 },
        "data": {
          "anyOf": [
            { "type": "string", "minLength": 0, "maxLength": 65536 },
            { "type": "number", "minimum": -1e308, "maximum": 1e308 },
            { "type": "boolean" },
            { "type": "null" },
            {
              "type": "array",
              "minItems": 0,
              "maxItems": 256,
              "items": {
                "anyOf": [
                  { "type": "string", "minLength": 0, "maxLength": 4096 },
                  { "type": "number", "minimum": -1e308, "maximum": 1e308 },
                  { "type": "boolean" },
                  { "type": "null" },
                  { "type": "object", "maxProperties": 64, "propertyNames": { "$ref": "#/definitions/keyName" } }
                ]
              }
            },
            { "type": "object", "maxProperties": 64, "propertyNames": { "$ref": "#/definitions/keyName" } }
          ]
        }
      }
    }
  }
}
