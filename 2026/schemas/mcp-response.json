{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "mcp-response-2026-07-28",
  "title": "Единый конверт MCP-ответа 2026-07-28",
  "description": "Финальное JSON-RPC-сообщение на server/discover или tools/call. Либо error, либо result с resultType complete. Кадр SSE эта схема не описывает: проверяется JSON внутри события data.",
  "type": "object",
  "additionalProperties": false,
  "required": ["jsonrpc", "id"],
  "properties": {
    "jsonrpc": { "enum": ["2.0"] },
    "id": { "$ref": "#/definitions/requestId" },
    "result": { "type": "object" },
    "error": { "$ref": "#/definitions/error" }
  },
  "oneOf": [
    { "$ref": "#/definitions/errorResponse" },
    { "$ref": "#/definitions/discoverResult" },
    { "$ref": "#/definitions/toolsCallResult" }
  ],
  "definitions": {
    "requestId": {
      "oneOf": [
        { "type": "string", "minLength": 1, "maxLength": 128 },
        { "type": "integer" }
      ]
    },
    "error": {
      "type": "object",
      "additionalProperties": true,
      "required": ["code", "message"],
      "properties": {
        "code": { "type": "integer" },
        "message": { "type": "string", "minLength": 1 },
        "data": {}
      }
    },
    "errorResponse": {
      "required": ["error"],
      "not": { "required": ["result"] }
    },
    "resultMeta": {
      "type": "object",
      "additionalProperties": true,
      "properties": {
        "io.modelcontextprotocol/serverInfo": {
          "type": "object",
          "additionalProperties": true,
          "required": ["name", "version"],
          "properties": {
            "name": { "type": "string", "minLength": 1, "maxLength": 128 },
            "version": { "type": "string", "minLength": 1, "maxLength": 64 }
          }
        }
      }
    },
    "textContent": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": true,
        "required": ["type", "text"],
        "properties": {
          "type": { "enum": ["text"] },
          "text": { "type": "string" }
        }
      }
    },
    "noFollowup": {
      "not": {
        "anyOf": [
          { "required": ["inputRequests"] },
          { "required": ["requestState"] }
        ]
      }
    },
    "discoverResultBody": {
      "type": "object",
      "additionalProperties": true,
      "required": ["resultType", "supportedVersions", "capabilities"],
      "allOf": [{ "$ref": "#/definitions/noFollowup" }],
      "properties": {
        "resultType": { "enum": ["complete"] },
        "supportedVersions": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "string" },
          "contains": { "enum": ["2026-07-28"] }
        },
        "capabilities": {
          "type": "object",
          "additionalProperties": false,
          "required": ["tools"],
          "properties": {
            "tools": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "listChanged": { "enum": [false] }
              }
            }
          }
        },
        "ttlMs": { "type": "integer", "minimum": 0 },
        "cacheScope": { "enum": ["public", "private"] },
        "_meta": { "$ref": "#/definitions/resultMeta" }
      }
    },
    "toolsCallResultBody": {
      "type": "object",
      "additionalProperties": true,
      "required": ["resultType", "content"],
      "allOf": [{ "$ref": "#/definitions/noFollowup" }],
      "properties": {
        "resultType": { "enum": ["complete"] },
        "content": { "$ref": "#/definitions/textContent" },
        "isError": { "type": "boolean" },
        "structuredContent": {},
        "_meta": { "$ref": "#/definitions/resultMeta" }
      }
    },
    "discoverResult": {
      "required": ["result"],
      "not": { "required": ["error"] },
      "properties": {
        "result": { "$ref": "#/definitions/discoverResultBody" }
      }
    },
    "toolsCallResult": {
      "required": ["result"],
      "not": { "required": ["error"] },
      "properties": {
        "result": { "$ref": "#/definitions/toolsCallResultBody" }
      }
    }
  }
}
